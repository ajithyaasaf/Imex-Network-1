rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Contact Inquiries Collection - Only authenticated admins can access
    match /contactInquiries/{inquiryId} {
      // Only authenticated users can read
      allow read: if request.auth != null;
      
      // Only authenticated users can update status
      allow update: if request.auth != null 
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status']);
      
      // Only authenticated users can delete
      allow delete: if request.auth != null;
      
      // Allow anyone to create (for contact form submissions)
      // But restrict which fields can be set
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'phone', 'projectType', 'location', 'description', 'status', 'createdAt'])
                    && request.resource.data.status == 'new'
                    && request.resource.data.createdAt is timestamp;
    }
    
    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
